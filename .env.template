# NGINX Config
COUNTRY_ISO=
PROVINCE=
CITY=
ORG_NAME=
# Domain the app is reached at, e.g. homeserver.lan: goes into the SSL
# certificate (make certs) and is the cookie domain. Empty: host-only cookies.
LAN_DOMAIN=
# This server's LAN IP; also goes into the certificate.
LAN_IP=
# Owner of the files the certs container writes to nginx/certs (default 1000).
# CERTS_UID=
# CERTS_GID=

# DB Config
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=
# disable (default), require, verify-full...
DB_SSLMODE=
# Port the app listens on (nginx proxies to 8080)
APP_PORT=8080

# Household time zone: which day a purchase falls on, month boundaries and
# "today" for reminders (default Europe/Sofia).
APP_TIMEZONE=

# JWT Config
# At least 32 bytes, e.g. openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=

# Recurring payment reminders: how often to check, e.g. 24h or 1h (default 24h, minimum 30m)
REMINDER_CHECK_INTERVAL=

# Reminder emails (optional; without SMTP_HOST reminders are only logged).
# Gmail: smtp.gmail.com, port 587, your Gmail address as user, and an app
# password (Google account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER; may include a name, e.g. Expenser <you@gmail.com>
SMTP_FROM=

# Where the app is reached, e.g. https://expenser.homeserver.lan. Reminder
# emails then get an "Open bills" button and snooze links (no login needed;
# they're signed). They only work on the network that can reach this address.
# Leave empty for emails without links.
APP_URL=

#GEMINI Config
GEMINI_API_KEY=
