
# DB Config
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=
DB_SSLMODE=
# Port the app listens on (the home server's nginx proxies to 8080)
APP_PORT=8080

# Signs the snooze links in reminder emails. At least 32 bytes, e.g.
# openssl rand -hex 32.
LINK_SECRET=

# The home server's domain, e.g. homeserver.lan: the language cookie is set
# for it, and Account / Log out go to https://auth.<LAN_DOMAIN>. Empty: this
# host only.
LAN_DOMAIN=

# Recurring payment reminders: how often to check, e.g. 24h or 1h (default 24h, minimum 30m)
REMINDER_CHECK_INTERVAL=

# Reminder emails (optional; without SMTP_HOST reminders are only logged).
# Gmail: smtp.gmail.com, port 587, your Gmail address as user, and an app
# password (Google account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER; may include a name, e.g. Expenser <you@gmail.com>
SMTP_FROM=

# Where the app is reached, e.g. https://expenser.homeserver.lan. Reminder
# emails then get an "Open bills" button and snooze links (no login needed;
# they're signed). They only work on the network that can reach this address.
# Leave empty for emails without links.
APP_URL=

#GEMINI Config
GEMINI_API_KEY=

# Developer helpers: no login needed (you are the dev seed user), and
# "Send test email" in the reminder settings. Never set this in production.
DEV_MODE=true

# Dev seed data (dev DB only)
SEED_DEV_DATA=
